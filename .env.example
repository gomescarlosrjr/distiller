# distiller configuration. Copy to .env and fill in as needed.
# All values have safe defaults; the local extraction engine needs no keys.

# --- Extraction engine -------------------------------------------------------
# local = Docling runs in-process (default, offline, no keys).
# vlm   = route page images through a remote vision LLM for best-quality
#         extraction of hard/scanned/complex PDFs and images.
EXTRACTION_ENGINE=local

# Run OCR in the local pipeline (scanned PDFs/images). Slower; off by default.
DO_OCR=false

# --- VLM extraction (only used when EXTRACTION_ENGINE=vlm) --------------------
# Provider whose OpenAI-compatible /v1/chat/completions endpoint Docling calls.
VLM_PROVIDER=groq                 # groq | anthropic

# Leave VLM_ENDPOINT / VLM_MODEL empty to use the per-provider defaults below.
VLM_ENDPOINT=
VLM_MODEL=

# Groq defaults:      https://api.groq.com/openai/v1/chat/completions
#                     meta-llama/llama-4-scout-17b-16e-instruct
# Anthropic defaults: https://api.anthropic.com/v1/chat/completions
#                     claude-sonnet-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Chunking ----------------------------------------------------------------
# generic = header/paragraph aware (good default for mixed docs)
# book    = whole-book PDFs: paragraph packing + overlap, tables kept whole
# curated = hand-written structured markdown, header-aware, no overlap
DEFAULT_CHUNK_PROFILE=book

# Hard cap per chunk in characters (~4 chars/token). 2000 ~= 500 tokens, safely
# inside nomic-embed-text (2048) and mxbai-embed-large (512-token) windows.
MAX_CHUNK_CHARS=2000

# Drop index/TOC-style chunks from the export (they are always reported, never
# silently removed).
FILTER_INDEX_CHUNKS=true

# --- Output ------------------------------------------------------------------
OUTPUT_DIR=./output
